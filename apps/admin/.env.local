# Browser-visible (optional). Server proxy prefers API_INTERNAL_URL.
NEXT_PUBLIC_API_URL=http://localhost:8081/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Server-only: Go base URL used by /api/auth/* and /api/go/*
# On this host :8080 is often Apache — run `make server` on :8081 (see root README).
API_INTERNAL_URL=http://localhost:8081/api/v1
