# Browser-visible (optional). Server proxy prefers API_INTERNAL_URL.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Server-only: Go base URL used by /api/auth/* and /api/go/*
# If :8080 is taken (e.g. Apache), point at the Go listen port (often :8081).
API_INTERNAL_URL=http://localhost:8080/api/v1
