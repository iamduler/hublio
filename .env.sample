DEVELOPMENT_MODE=development
# Interactive API docs (Scalar) at /docs — default on when DEVELOPMENT_MODE=development
# ENABLE_API_DOCS=true
API_KEY=
SERVER_PORT=8080
# App connection for Hublio (separate from Navicat project DB).
DB_HOST=localhost
DB_PORT=5432
DB_USER=hublio
DB_PASSWORD=hublio
DB_NAME=hublio
DB_SSLMODE=disable

# Bootstrap admin. On WSL/Ubuntu you can leave password empty and the script
# will fall back to: sudo -u postgres psql (peer auth).
# Do NOT use a limited Navicat user (e.g. duler) here — it cannot CREATE ROLE.
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=
DB_ADMIN_DB=postgres
# DB_ADMIN_USE_PEER=1
# DB_VIA_DOCKER=1
# DB_DOCKER_CONTAINER=postgres

REDIS_ADDRESS=localhost:6379
REDIS_USER=
REDIS_PASSWORD=
REDIS_DB=0

RATE_LIMIT_REQUESTS_SEC=5
RATE_LIMIT_BURST=10

LIMIT_ITEMS_PER_PAGE=10

JWT_SECRET_KEY=
JWT_ENCRYPT_KEY=

# OAuth (optional — buttons disabled when unset). Client IDs are needed by
# both Go (token exchange) and Next (authorize redirect). Secrets stay on Go.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/oauth/callback
# NEXT_PUBLIC_DEMO_LOGIN=true

# Exactly 32 bytes. Used to encrypt Connection credentials at rest (AES-GCM).
# Dev default is applied in code if empty — set a real key before any non-local deploy.
CREDENTIAL_ENCRYPTION_KEY=dev-only-insecure-32-byte-key!!!

# 32 bytes (raw, 64 hex chars, or base64). Encrypts user TOTP secrets at rest (AES-GCM).
# Falls back to CREDENTIAL_ENCRYPTION_KEY when unset; MFA endpoints are disabled if neither
# resolves to 32 bytes.
MFA_ENCRYPTION_KEY=

# Provider credentials are NOT env vars for the running API — store them on Connection
# secrets via the Management API. For local MISA Web API smoke (doc.meinvoice.vn/webapi):
#   MISA_TAX_CODE / MISA_USERNAME / MISA_PASSWORD → ./scripts/misa_webapi_smoke.sh
# See docs/31-misa-meinvoice-smoke.md (SoT: https://doc.meinvoice.vn/webapi/intro.html).
# Hublio connector code=misa uses Integration Open API (needs app_id on Connection secret):
#   config.tax_code + config.inv_series (+ optional config.base_url=testapi…/api/integration)
#   secret.app_id / username / password
# Nhanh (code=nhanh): config.app_id + config.business_id; secret.access_token.

FRONTEND_URL=

# Public base URL of the web app; used to build links in transactional emails
# (e.g. password reset). Defaults to http://localhost:3000 when unset.
APP_WEB_URL=http://localhost:3000

MAIL_PROVIDER_TYPE=mailtrap

MAILTRAP_API_KEY=
MAILTRAP_API_URL=
MAILTRAP_MAIL_SENDER=
MAILTRAP_NAME_SENDER=

RABBITMQ_URL=amqp://guest:guest@localhost:5672/
